# WebHackingTools configuration
# ------------------------------------------------------------------
# Tool versions are no longer pinned here: Go and every GitHub release
# are fetched dynamically ("latest") by installer.sh, and Go tools are
# installed with `go install ...@latest`. Nothing to bump by hand.
# ------------------------------------------------------------------

# Directory where git-cloned tools & wordlists are stored
TOOLS_DIRECTORY="/home/hack/tools"

# Fallback Go version, used only if https://go.dev/VERSION is unreachable
GO_FALLBACK_VERSION="1.27.1"

# Optional GitHub token. If set, it raises the GitHub API rate limit used
# to resolve latest releases, and is available to tools that need one
# (github-subdomains, GitDorker, gitGraber, ...). Leave empty to skip.
# GITHUB_TOKEN=""

# Colors
RED='\033[00;31m'
GREEN='\033[00;32m'
YELLOW='\033[00;33m'
BLUE='\033[00;34m'
PURPLE='\033[00;35m'
CYAN='\033[00;36m'
LIGHTGRAY='\033[00;37m'
LRED='\033[01;31m'
LGREEN='\033[01;32m'
LYELLOW='\033[01;33m'
LBLUE='\033[01;34m'
LPURPLE='\033[01;35m'
LCYAN='\033[01;36m'
WHITE='\033[01;37m'
RESTORE='\033[0m'
